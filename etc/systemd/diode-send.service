[Unit]
Description=Data diode sender (online / external side)
After=network.target

[Service]
Type=simple
User=diode
Group=diode
ExecStart=/usr/local/bin/diode_send --directory /home/diode/send
Restart=on-failure
RestartSec=2
# To forward UDP arriving on 127.0.0.1:9001 through the diode add
# `--udp-port 9001 --udp-host 127.0.0.1` to ExecStart. To tune pacing
# add `--target-bitrate-mbps 90`.
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/diode/send
PrivateTmp=true

[Install]
WantedBy=multi-user.target
